<odoo>
    <record id="view_generator_form" model="ir.ui.view">
        <field name="name">generator.form</field>
        <field name="model">odoo.field.generator</field>
        <field name="arch" type="xml">
            <form string="Odoo Field Generator">
                <sheet>
                    <div>
                        <span style="color:red;font-weight:bold">Notation</span>
                        <br/>
                        <code>
                            c: Char,
                            i: Integer,
                            f: Float,
                            d: Date,
                            dt: Datetime,
                            bi: Binary,
                            s: Selection,
                            b: Boolean,
                            mo: Many2one,
                            om: One2many,
                            mm: Many2many
                        </code>
                    </div>
                    <group>
                        <field name="variable_input"
                               placeholder="name.c,
    age.i,
    salary.f,
    date_of_birth.d,
    date_of_joining.dt,
    profile_image.bi,
    gender.s,
    is_employee.b,
    project_manager.mo,
    employee_assets.om,
    projects_involves.mm"/>
                        <button name="action_generate"
                                string="Generate"
                                type="object"
                                class="btn-primary"/>
                    </group>
                    <notebook>
                        <page string="Python Fields">
                            <field name="python_output" widget="text"/>
                        </page>
                        <page string="XML Fields">
                            <field name="xml_output" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_generator" model="ir.actions.act_window">
        <field name="name">Field Generator</field>
        <field name="res_model">odoo.field.generator</field>
        <field name="view_mode">form</field>
    </record>


    <menuitem id="menu_generator_root"
              name="Dev Tools"/>

    <menuitem id="menu_field_generator"
              name="Field Generator"
              parent="menu_generator_root"
              action="action_generator"/>

</odoo>