<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_single_session"
            model="ir.ui.view">
        <field name="name">res.users.form.single.session</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="single_session_control" string="Session Control" groups="base.group_system">
                    <group>
                        <field name="allow_multiple_sessions"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
