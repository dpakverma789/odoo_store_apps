<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="disable_login_autocomplete"
              inherit_id="web.login"
              name="Disable Login Autocomplete">

        <!-- Disable autofill -->
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="autocomplete">off</attribute>
        </xpath>

        <xpath expr="//input[@name='password']" position="attributes">
            <attribute name="autocomplete">new-password</attribute>
        </xpath>

        <!-- Security message under password -->
        <xpath expr="//input[@name='password']" position="after">
            <div class="text-muted small mt-1" style="font-size:12px;">
                🔒 Paste disabled for security
            </div>
        </xpath>

    </template>

</odoo>