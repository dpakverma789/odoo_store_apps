<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="session_list" model="ir.ui.view">
        <field name="name">user.session.list</field><field name="model">user.session</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" export_xlsx="0">
                <field name="user_id"/><field name="login_datetime"/><field name="last_activity_datetime"/>
                <field name="browser"/><field name="ip_address"/><field name="status" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="history_list" model="ir.ui.view">
        <field name="name">user.session.history.list</field><field name="model">user.session</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" export_xlsx="0">
                <field name="user_id"/><field name="login_datetime"/><field name="end_datetime"/>
                <field name="duration_minutes"/><field name="status" widget="badge"/>
                <field name="end_reason"/><field name="ip_address"/>
            </list>
        </field>
    </record>
    <record id="session_form" model="ir.ui.view">
        <field name="name">user.session.form</field><field name="model">user.session</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_end_session" type="object" string="End Session" class="oe_highlight"
                        groups="base.group_system" invisible="status != 'active'"
                        confirm-title="End Session?" confirm-label="End Session"
                        confirm="Are you sure you want to end this user's active session?"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet><group>
                    <group><field name="user_id"/><field name="login_datetime"/><field name="last_activity_datetime"/>
                        <field name="end_datetime"/><field name="duration_minutes"/></group>
                    <group><field name="browser"/><field name="ip_address"/><field name="user_agent"/>
                        <field name="end_reason"/><field name="revoked_by"/></group>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="session_search" model="ir.ui.view">
        <field name="name">user.session.search</field><field name="model">user.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <filter name="today" string="Logged in Today" domain="[('login_datetime', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter name="active_sessions" string="Active" domain="[('status', '=', 'active')]"/>
                <filter name="ended" string="Ended" domain="[('status', '=', 'ended')]"/>
                <filter name="expired" string="Expired" domain="[('status', '=', 'expired')]"/>
                <filter name="rejected" string="Rejected" domain="[('status', '=', 'rejected')]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_reason" string="End Reason" context="{'group_by': 'end_reason'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_active_sessions" model="ir.actions.act_window">
        <field name="name">Active Sessions</field><field name="res_model">user.session</field>
        <field name="view_mode">list,form</field><field name="view_id" ref="session_list"/>
        <field name="search_view_id" ref="session_search"/>
        <field name="domain">[('status', '=', 'active')]</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No active sessions found.</p></field>
    </record>
    <record id="action_session_history" model="ir.actions.act_window">
        <field name="name">Session History</field><field name="res_model">user.session</field>
        <field name="view_mode">list,form</field><field name="view_id" ref="history_list"/>
        <field name="search_view_id" ref="session_search"/>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem id="menu_session_control" name="Session Control" sequence="80" groups="base.group_system"/>
    <menuitem id="menu_active_sessions" name="Active Sessions" parent="menu_session_control" action="action_active_sessions" sequence="10"/>
    <menuitem id="menu_session_history" name="Session History" parent="menu_session_control" action="action_session_history" sequence="20"/>
</odoo>
