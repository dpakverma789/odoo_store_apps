<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_expire_sessions" model="ir.cron">
        <field name="name">Session Control: expire idle sessions</field>
        <field name="model_id" ref="model_user_session"/><field name="state">code</field>
        <field name="code">model._cron_expire()</field>
        <field name="interval_number">1</field><field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="cron_cleanup_history" model="ir.cron">
        <field name="name">Session Control: clean session history</field>
        <field name="model_id" ref="model_user_session"/><field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field><field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
